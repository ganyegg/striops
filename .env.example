# Striops environment configuration
# Copy to .env and fill in secrets. Never commit .env.

# --- Reasoning / LLM ---
# Google Gemini API key. If empty, Striops uses a deterministic MockProvider
# so the whole system still runs offline and in CI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- PostgreSQL (facts + pgvector) ---
# Production: a Neon URI. Takes precedence over the split vars below.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=striops
POSTGRES_USER=striops
POSTGRES_PASSWORD=striops

# --- Neo4j (Strategic Twin) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=striops-strategic-twin

# --- App ---
STRIOPS_ENV=development
STRIOPS_LOG_LEVEL=INFO
# Municipality focus (National Treasury demarcation code)
STRIOPS_MUNICIPALITY=CPT
# Public frontend -> backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
