# Helm AI environment configuration
# Copy to .env and fill in secrets. Never commit .env.

# --- Reasoning / LLM ---
# Google Gemini API key. If empty, Helm AI uses a deterministic MockProvider
# so the whole system still runs offline and in CI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- PostgreSQL (facts + pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=helm
POSTGRES_USER=helm
POSTGRES_PASSWORD=helm

# --- Neo4j (Strategic Twin) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=helm-strategic-twin

# --- App ---
HELM_ENV=development
HELM_LOG_LEVEL=INFO
# Municipality focus (National Treasury demarcation code)
HELM_MUNICIPALITY=CPT
# Public frontend -> backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
